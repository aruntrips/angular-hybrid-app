{
  "name": "task-manager",
  "root": "apps/task-manager",
  "sourceRoot": "apps/task-manager/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack --config apps/task-manager/webpack.config.js --mode production",
        "cwd": "."
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack serve --config apps/task-manager/webpack.config.js --mode development",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node apps/task-manager/smoke-test.js",
        "cwd": "."
      }
    }
  }
}
